{
  "name": "eso-toolkit-discord-bot",
  "version": "1.0.0",
  "packageManager": "npm@11.5.2",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "register": "node scripts/register-commands.js",
    "panel": "node scripts/setup-panel.js",
    "typecheck": "tsc --noEmit",
    "check:oauth-client-id": "node scripts/check-oauth-client-id.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.120.0"
  }
}
