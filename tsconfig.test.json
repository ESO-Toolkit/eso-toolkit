{
  // Typecheck-only project for the test suite. The base tsconfig excludes every
  // *.test.ts(x), so `tsc --noEmit` never covers the ~4300-test suite; this config
  // re-includes them (with jest globals) so CI can typecheck tests via
  // `npm run typecheck:test`. Kept separate so the main build/typecheck stays fast
  // and test-only types don't leak into the app graph.
  //
  // The `exclude` list below is a QUARANTINE, not a policy: those files already
  // had type errors when the gate was introduced. The list may only ever shrink —
  // fix a file's errors, delete its line. New test files are covered from day one,
  // which is the point of the gate.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"]
  },
  "include": ["src", "playwright/*.config.ts"],
  "exclude": [
    "node_modules",
    "build",
    "src/data/skill-lines/**/*",

    // Storybook stories are excluded from the base tsconfig too; wiring them into
    // a typecheck is separate follow-up work, not part of the test gate.
    "**/*.stories.ts",
    "**/*.stories.tsx",

    // ── Quarantine (pre-existing test type errors; count at time of quarantine) ──
    "src/components/dashboard/DeathCausesWidget.test.tsx",
    "src/components/HeaderBar.test.tsx",
    "src/components/SkillTooltip.kalpa-ground-truth.test.tsx",
    "src/features/build-editor/engine/stat-engine.baseClassPassives.test.ts",
    "src/features/fight_replay/components/MapMarkers.integration.test.tsx",
    "src/features/fight_replay/components/ShareButton.test.tsx",
    "src/features/fight_replay/components/TimelineLegend.test.tsx",
    "src/features/loadout-manager/utils/__tests__/luaParser.test.ts",
    "src/features/loadout-manager/utils/__tests__/wizardsWardrobeSavedVariables.test.ts",
    "src/features/loadout-manager/utils/__tests__/wizardWardrobeConverter.test.ts",
    "src/features/loadout-manager/utils/__tests__/wizardWardrobeImport.integration.test.ts",
    "src/features/parse_analysis/utils/parseAnalysisUtils.test.ts",
    "src/features/parse_analysis/utils/parseChecklistUtils.test.ts",
    "src/features/report_details/deaths/DeathEventPanel.test.tsx",
    "src/features/report_details/fightGrouping.test.ts",
    "src/features/report_details/insights/__tests__/PlayersPanelView.test.tsx",
    "src/features/report_details/insights/StatusEffectUptimesPanel.integration.test.ts",
    "src/features/report_details/synergy/synergyUtils.test.ts",
    "src/features/report_summary/__tests__/EnhancedDeathAnalysisSection.test.tsx",
    "src/features/report_summary/__tests__/ReportSummaryPage.test.tsx",
    "src/features/report_summary/hooks/useOptimizedReportSummaryData.test.tsx",
    "src/features/report_summary/reportSummaryTables.test.ts",
    "src/features/role_detection/__tests__/extractSignals.test.ts",
    "src/features/scribing/analysis/__tests__/scribingDetectionAnalysis.affix-accuracy.test.ts",
    "src/hooks/useLatestReport.test.tsx",
    "src/hooks/useSelectedFight.test.tsx",
