{
  // Typecheck-only project for the test suite. The base tsconfig excludes every
  // *.test.ts(x), so `tsc --noEmit` never covers the ~4300-test suite; this config
  // re-includes them (with jest globals) so CI can typecheck tests via
  // `npm run typecheck:test`. Kept separate so the main build/typecheck stays fast
  // and test-only types don't leak into the app graph.
  //
  // The `exclude` list below is a QUARANTINE, not a policy: those files already
  // had type errors when the gate was introduced. The list may only ever shrink —
  // fix a file's errors, delete its line. New test files are covered from day one,
  // which is the point of the gate.
  //
  // SCOPE: this gate covers the jest suite under src/ AND the Playwright specs
  // under tests/. The resolver problem that used to keep tests/ out — specs
  // importing app code as `import('/src/utils/foo.ts')`, a URL Vite serves to
  // the browser rather than a Node path — is solved by the `/src/*` entry in
  // `paths` below, so those imports are typechecked against the real modules
  // instead of being suppressed. `npm run lint` covers ./src and ./tests to
  // match.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    // Playwright specs reach into app code with `await import('/src/utils/x.ts')`
    // inside `page.evaluate`. That specifier is a URL Vite serves to the browser,
    // not a Node path, so it is correct as written and unresolvable by default.
    // Mapping it to the real file typechecks those imports properly instead of
    // suppressing them. `paths` REPLACES rather than merges, so the inherited
    // aliases are repeated here.
    "allowImportingTsExtensions": true,
    "paths": {
      "/src/*": ["src/*"],
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@features/*": ["src/features/*"],
      "@store/*": ["src/store/*"],
      "@types/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"],
      "@graphql/*": ["src/graphql/*"]
    },
    // Its own incremental cache: inheriting the base tsBuildInfoFile would have
    // both projects writing one file, so whichever ran last invalidated the
    // other's state and the two gates could disagree.
    "tsBuildInfoFile": "./node_modules/.cache/.tsbuildinfo.test"
  },
  "include": ["src", "tests", "playwright/*.config.ts"],
  "exclude": [
    "node_modules",
    "build",
    "src/data/skill-lines/**/*",

    // Storybook stories are excluded from the base tsconfig too; wiring them into
    // a typecheck is separate follow-up work, not part of the test gate.
    "**/*.stories.ts",
    "**/*.stories.tsx",

    // ── Quarantine: pre-existing test type errors, shrink-only ──
    "src/components/dashboard/DeathCausesWidget.test.tsx",
    "src/features/build-editor/engine/stat-engine.baseClassPassives.test.ts",
    "src/features/fight_replay/components/MapMarkers.integration.test.tsx",
    "src/features/loadout-manager/utils/__tests__/wizardWardrobeImport.integration.test.ts",
    "src/features/loadout-manager/utils/__tests__/wizardsWardrobeSavedVariables.test.ts",
    "src/features/parse_analysis/utils/parseAnalysisUtils.test.ts",
    "src/features/report_details/deaths/DeathEventPanel.test.tsx",
    "src/features/report_details/insights/StatusEffectUptimesPanel.integration.test.ts",
    "src/features/report_details/synergy/synergyUtils.test.ts",
    "src/features/scribing/analysis/__tests__/scribingDetectionAnalysis.affix-accuracy.test.ts",
    "src/hooks/useSelectedTargetIds.test.tsx",
    "src/pages/RaidDashboardPage.test.tsx",
    "src/player1-shattering-knife-new-architecture.test.ts",
    "src/store/report/reportSlice.test.ts",
    "src/store/storeWithHistory.test.ts",
    "src/store/user_reports/userReportsSelectors.test.ts",
    "src/store/user_reports/userReportsSlice.test.ts",
    "src/utils/classDetectionUtils.test.ts",
    "src/utils/errorTracking.test.ts",
    "src/utils/skillTooltipMapper.test.ts",
    "src/workers/WorkerPool.test.ts",

    // ── Quarantine: Playwright specs, same shrink-only rule ──
    // Everything else under tests/ typechecks. These two are the remainder of
    // the errors that surfaced once the `/src/*` path mapping made the in-page
    // dynamic imports resolvable; both are `page.evaluate` return values typed
    // as `unknown` plus roster fixtures built from string literals where the
    // app types want unions.
    "tests/performance.spec.ts",
    "tests/roster-builder.comprehensive.smoke.spec.ts"
  ]
}
