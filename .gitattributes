* text=auto eol=lf

# Keep build inputs and CI configuration reproducible across platforms.
*.json text eol=lf
*.graphql text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Preserve native Windows script line endings.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly mark binary assets so Git never attempts text conversion.
*.avif binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
*.glb binary
*.gltf binary
