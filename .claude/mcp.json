{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "eso-logs-github": {
      "command": "node",
      "args": ["--import", "tsx", "tools/mcp/github-server/src/index.ts"],
      "env": {
        "GH_TOKEN": "${GH_TOKEN:-}"
      }
    },
    "eso-logs-ci": {
      "command": "node",
      "args": ["--import", "tsx", "tools/mcp/ci-server/src/index.ts"],
      "env": {
        "GH_TOKEN": "${GH_TOKEN:-}"
      }
    },
    "eso-logs-worktree": {
      "command": "node",
      "args": ["--import", "tsx", "tools/mcp/worktree-server/src/index.ts"]
    }
  }
}
