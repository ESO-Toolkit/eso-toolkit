{
  "name": "esotk-promo-video",
  "private": true,
  "version": "1.0.0",
  "description": "Code-generated promo video for esotk.com (WebGL2 + Canvas2D, rendered in headless Chrome)",
  "type": "module",
  "scripts": {
    "soundtrack": "node scripts/soundtrack.mjs",
    "render": "npm run soundtrack && npm run render:landscape && npm run render:vertical",
    "render:landscape": "node scripts/render.mjs",
    "render:vertical": "node scripts/render.mjs --portrait",
    "stills": "node scripts/render.mjs --stills",
    "format": "prettier --write README.md engine scripts timeline.json",
    "format:check": "prettier --check README.md engine scripts timeline.json"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "ffmpeg-static": "5.3.0",
    "node-web-audio-api": "2.2.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9"
  }
}
