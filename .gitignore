# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# Agent skill dependencies (MCP servers)
/.github/copilot-skills/*/node_modules/
/.claude/*/node_modules/

# Cache directories
/cache/

# Scratch directory for ad-hoc agent/debug output (keep .gitkeep)
/scratch/*
!/scratch/.gitkeep

# testing
/coverage
/test-results/
/test-results-nightly/
/test-results-manual/
/test-results-extracted/
/test-results-screen-sizes/
/playwright-report/
/playwright-report-nightly/
/screen-size-report/
/screen-size-reports/
/playwright/.cache/
/tests/auth-state.json
/tests/auth-metadata.json
/.playwright-mcp/

# Screen size test report directories and artifacts (keep baseline screenshots)
/tests/screen-sizes/**/test-results/
/tests/screen-sizes/**/*-actual.png
/tests/screen-sizes/**/*-expected.png
/tests/screen-sizes/**/*-diff.png

# Screen size test artifacts (prevent screenshots in root directory)
/*-overview-*.png
/*-viewport-*.png
/test-output/

# Additional Playwright test artifacts
/test-results*/
/playwright-report*/
*.trace
*.webm
*.zip
/artifacts/
/downloads/

# HTML report metadata and test run artifacts
test-metadata.json
*.har
*.video

# CI/CD temporary files
/gh-pages/
/reports-temp/
.last-run.json

# Local capture/build output (screenshots, videos, demos)
/out/

# Recordings not yet wired into the app
/public/recordings/

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
.env

npm-debug.log*
yarn-debug.log*
yarn-error.log*

*storybook.log
storybook-static
.twig/

# fetch checkpoints
data/abilities.fetch.checkpoint.json

# Sample data for testing/debugging (downloaded by scripts/download-report-data.mts)
sample-data/
data-downloads/

# Scribing database backups (generated by shrinkwrap system)
data/backups/

# But keep the shrinkwrap file itself
!data/.scribing-shrinkwrap.json

# nested repository folder
eso-log-aggregator/

# Auto-generated version files (created during build)
public/version.json
public/manifest.json

# MSW service worker (should only exist in .storybook/public/)
public/mockServiceWorker.js

# Vite cache directory
/.vite/

# Claude AI assistant local settings (keep skill but protect sensitive data)
/.claude/node_modules/
/.claude/mcp.json
/.claude/mcp-config.json
/.claude/screenshots/
/.claude-rules.md
/.claude/settings.local.json
/.claude/worktrees/
.claudeignore
nul

# Build cache and temporary directories
/cache/
/logs/
/reports/
/validation-reports/

# Environment files (additional patterns)
.env.*
!.env.example
!.env.template

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS specific files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# Temporary files
*.tmp
*.temp
*.lock
*.pid
.playwright-mcp/
tmp/
.github/tmp-pr-body.md

# Discord bot / worker dependencies & secrets
discord-bot/node_modules/
discord-bot/.dev.vars
discord-notify-worker/node_modules/

# Wrangler local secrets (never commit)
.dev.vars

# Debug and test files in root
/debug-*.js
/debug-*.json
/test-*.js
/test-*.txt
/error-logs-*.txt
/*.log
/*-snapshot.md
/snapshot.txt
/*-failure.md
/missing-*.txt

# Claude session artifacts (screenshots, debug output, prompt drafts)
/*.png
/*.a11y.md
/prompts/
/showcase-video/

# Third-party AI/editor tool scratch directories
/.continue/
/.windsurf/

# Agent scratch directory — keep markdown notes trackable, but ignore
# large binary artefacts (Chrome perf traces can be >300 MB) and tool
# scaffolding subdirs.
/.factory/*.json
/.factory/*.png
/.factory/*.webm
/.factory/*.har
/.factory/*.trace
/.factory/skills/
