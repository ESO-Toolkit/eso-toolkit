{
  "name": "roster-hub-api",
  "version": "1.0.0",
  "packageManager": "npm@11.5.2",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute roster-hub-db --file=src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute roster-hub-db --remote --file=src/db/schema.sql",
    "db:seed": "wrangler d1 execute roster-hub-db --file=src/db/seed.sql",
    "db:seed:remote": "wrangler d1 execute roster-hub-db --remote --file=src/db/seed.sql",
    "db:seed:update": "wrangler d1 execute roster-hub-db --file=src/db/seed-update.sql",
    "db:seed:update:remote": "wrangler d1 execute roster-hub-db --remote --file=src/db/seed-update.sql",
    "test": "cd .. && npm run test:roster-hub",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.120.0"
  }
}
